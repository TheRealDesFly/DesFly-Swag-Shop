{
  "name": "desfly-swag-shop",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@wix/cli": "^1.0.0",
    "@wix/eslint-plugin-cli": "^1.0.0",
    "eslint": "^8.25.0",
    "react": "16.14.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "sync-types": "wix sync-types",
    "dev": "wix dev",
    "predev": "npm run configure:types",
    "configure:types": "node scripts/configure-wix-types.js",
    "check:types:inventory": "node scripts/check-inventory-types.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:diagnostic": "vitest run tests/isendDiagnostic.integration.test.js tests/isendService.test.js tests/http-functions.test.js tests/isendConfig.test.js tests/check-staging-connection.test.js tests/check-dev-environment.test.js",
    "check": "npm run lint && npm run check:types:inventory && npm run test",
    "check:dev:setup": "node scripts/check-dev-environment.js",
    "check:dev": "npm run check:dev:setup && npm run lint && npm run test:diagnostic",
    "check:dev:live": "node scripts/check-staging-connection.js --skip-wix --force --require-live",
    "check:isend": "node scripts/check-isend.js",
    "check:production": "node scripts/check-isend.js --env production --require-wix",
    "check:inventory": "node scripts/check-isend-inventory.js",
    "canary:production": "node scripts/run-production-isend-canary.js",
    "provision:wix:runtime-secrets": "node scripts/provision-wix-runtime-secrets.mjs",
    "check:capacity": "node scripts/check-isend-capacity.js",
    "check:staging": "node scripts/check-staging-connection.js",
    "check:staging:setup": "node scripts/check-staging-connection.js --validate-setup",
    "check:staging:diagnose": "node scripts/check-staging-connection.js --diagnose"
  }
}

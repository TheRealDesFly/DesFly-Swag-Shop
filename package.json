{
  "name": "desfly-swag-shop",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@wix/cli": "^1.0.0",
    "@wix/eslint-plugin-cli": "^1.0.0",
    "eslint": "^8.25.0",
    "react": "16.14.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "sync-types": "wix sync-types",
    "dev": "wix dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test",
    "check:isend": "node scripts/check-isend.js",
    "check:capacity": "node scripts/check-isend-capacity.js",
    "check:staging": "node scripts/check-staging-connection.js",
    "check:staging:setup": "node scripts/check-staging-connection.js --validate-setup",
    "check:staging:diagnose": "node scripts/check-staging-connection.js --diagnose"
  }
}

# Direct iStore iSend staging login
ISTORE_ISEND_API_USER_ID=
ISTORE_ISEND_API_PASSWORD=
# Use the iStore/iSend host or API context root; the code appends /Json/... and tries /IsisWMS-War automatically.
ISTORE_ISEND_SANDBOX_URL=https://staging.istoreisend-wms.com:5191/IsisWMS-War
ISTORE_ISEND_PRODUCTION_URL=https://istoreisend-wms.com:5191/IsisWMS-War

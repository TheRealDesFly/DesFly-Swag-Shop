# Direct iStore iSend staging login
ISTORE_ISEND_API_USER_ID=
ISTORE_ISEND_API_PASSWORD=
# HTTPS only. The backend accepts only the documented environment-specific
# iStore/iSend host/port and either the host root or /IsisWMS-War.
# Staging also permits https://webapi.istoreisend-wms.com/IsisWMS-War.
# The owner-approved staging /api/login exception is pinned in code by SHA-256
# origin fingerprint 36dc1cea96d6bb7e9e448ebe63e4511488c3fc9c04f91adb4535a6d0e90a36cb;
# its private hostname is intentionally omitted and must not be substituted.
ISTORE_ISEND_SANDBOX_URL=https://staging.istoreisend-wms.com:5191/IsisWMS-War
ISTORE_ISEND_STORAGE_CLIENT_NO=
ISTORE_ISEND_ORDER_ORIGIN=WIX_STORE
ISTORE_ISEND_ENV=staging

# Deploy-only production root. Keep blank in local development.
ISTORE_ISEND_PRODUCTION_URL=

# Optional production-runtime verification inputs. They are not required for
# local development or the direct read-only iSend connectivity check.
WIX_SITE_BASE_URL=
# Sent as X-ISEND-POLLER-SECRET when probing the protected Wix diagnostic endpoint.
ISEND_POLLER_TRIGGER_SECRET=

# Optional local timeout override in milliseconds.
CHECK_ISEND_TIMEOUT=20000

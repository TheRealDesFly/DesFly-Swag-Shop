{
  "jobs": [
    {
      "functionLocation": "/isendOrderOutbox.js",
      "functionName": "runISendOrderOutboxJob",
      "description": "Process durable Wix order submissions to iStore iSend",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/isendPoller.js",
      "functionName": "runISendPollerJob",
      "description": "Reconcile active iSend mappings as a webhook safety net",
      "executionConfig": {
        "cronExpression": "30 * * * *"
      }
    },
    {
      "functionLocation": "/isendClaimRetention.js",
      "functionName": "runISendClaimRetentionJob",
      "description": "Remove old nonlatest released iSend claim generations",
      "executionConfig": {
        "cronExpression": "15 18 * * *"
      }
    },
    {
      "functionLocation": "/isendOperationalHealth.js",
      "functionName": "runISendOperationalHealthJob",
      "description": "Fail visibly on iSend durable-state, retention, or capacity alerts",
      "executionConfig": {
        "cronExpression": "45 * * * *"
      }
    }
  ]
}

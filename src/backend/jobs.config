{
  "jobs": [
    {
      "functionLocation": "/isendOrderOutbox.js",
      "functionName": "runISendOrderOutboxJob",
      "description": "Process durable Wix order submissions to iStore iSend",
      "executionConfig": {
        "cronExpression": "0 * * * *"
      }
    },
    {
      "functionLocation": "/isendPoller.js",
      "functionName": "runISendPollerJob",
      "description": "Reconcile active iSend mappings as a webhook safety net",
      "executionConfig": {
        "cronExpression": "30 * * * *"
      }
    }
  ]
}
